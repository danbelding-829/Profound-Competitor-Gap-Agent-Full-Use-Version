      "data": {
        "provider_id": "code_executor",
        "tool_parameters": {
          "code": "function main(node1_output, user_domain) {\n  const data = typeof node1_output === 'string' ? JSON.parse(node1_output) : node1_output;\n  const organicResults = data.organic_results || [];\n  const topResult = organicResults.find(item => item.position === 1);\n  const topURL = topResult ? topResult.link : null;\n\n  let matchesDomain = false;\n  \n  if (topURL && user_domain) {\n    // 1. Normalize the user domain (remove http, www, and trailing slashes)\n    const cleanUserDomain = user_domain.toLowerCase()\n      .replace(/^(https?:\\/\\/)?(www\\.)?/, '')\n      .replace(/\\/$/, '');\n\n    // 2. Check if the topURL contains your clean domain\n    // This handles both root (silverfort.com) and deep links (silverfort.com/blog/...)\n    matchesDomain = topURL.toLowerCase().includes(cleanUserDomain);\n  }\n\n  const now = new Date();\n  const query_date = now.toISOString().split('T')[0];\n\n  return {\n    top_URL: topURL,\n    domain_match: matchesDomain, // This will now correctly return TRUE for deep links\n    query_date: query_date\n  };\n}",
          "timeout": 120,
          "language": "javascript",
