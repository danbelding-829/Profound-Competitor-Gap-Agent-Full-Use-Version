          "code": "function main(LLM_output) {\n  // Finds the line starting with RECOMMENDED_URL: and grabs the link\n  const match = LLM_output.match(/RECOMMENDED_URL:\\s*(https?:\\/\\/[^\\s]+)/);\n  const internalURL = match ? match[1] : \"No match found\";\n\n  return {\n    target_internal_URL: internalURL\n  };\n}",
